<Window x:Class="VideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VideoEditor.App.Controls"
        Title="影片編輯器" Icon="app.ico" Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        Background="#1E1E1E" FontFamily="Microsoft JhengHei UI" AllowDrop="True"
        Drop="OnFileDrop" PreviewKeyDown="OnPreviewKeyDown" Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CC4F0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- 素材清單 -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="8">
            <Button x:Name="ImportButton" AutomationProperties.AutomationId="ImportButton" DockPanel.Dock="Top" Margin="0,0,0,6" Content="匯入素材…（或拖放到視窗）" Click="OnImportClick" />
            <TextBlock x:Name="MediaDetails" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                       AutomationProperties.AutomationId="MediaDetails" />
            <ListBox x:Name="MediaList" AutomationProperties.AutomationId="MediaList" SelectionChanged="OnMediaSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Image Source="{Binding Thumbnail}" Width="72" Height="44" Stretch="Uniform" Margin="0,0,6,0" />
                            <StackPanel Width="130">
                                <TextBlock Text="{Binding Info.FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <TextBlock Text="{Binding Summary}" Foreground="#9A9A9A" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 預覽 -->
        <Grid x:Name="PreviewArea" Grid.Row="0" Grid.Column="1" Margin="0,8,0,4" Background="#0C0C0C" ClipToBounds="True" SizeChanged="OnPreviewAreaResized">
            <Canvas>
                <Rectangle x:Name="FrameFill" Fill="Black" />
                <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" AutomationProperties.AutomationId="PreviewImage" />
                <Path x:Name="CropDim" Fill="#A0000000" IsHitTestVisible="False" />
                <Rectangle x:Name="FrameBorder" Stroke="#FFD24A" StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False" />
            </Canvas>
            <TextBlock x:Name="EmptyHint" Text="匯入素材後，在這裡預覽並用 I / O 標記入出點" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777777" />
        </Grid>

        <!-- 播放控制 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
            <Grid Margin="0,0,0,4">
                <Slider x:Name="ScrubSlider" AutomationProperties.AutomationId="ScrubSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Focusable="False" ValueChanged="OnScrubChanged" />
                <Canvas x:Name="MarkCanvas" IsHitTestVisible="False" Height="4" VerticalAlignment="Bottom">
                    <Rectangle x:Name="MarkRange" Height="4" Fill="#FFD24A" />
                </Canvas>
            </Grid>
            <DockPanel>
                <TextBlock x:Name="TimeText" AutomationProperties.AutomationId="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Consolas" Text="00:00:00.00 / 00:00:00.00" />
                <WrapPanel>
                    <Button x:Name="PlayButton" AutomationProperties.AutomationId="PlayButton" Content="▶ 播放" Width="72" Click="OnPlayClick" ToolTip="空白鍵" />
                    <Button Content="◀ 前一格" AutomationProperties.AutomationId="StepBackButton" Click="OnStepBack" ToolTip="←" />
                    <Button Content="後一格 ▶" AutomationProperties.AutomationId="StepForwardButton" Click="OnStepForward" ToolTip="→" />
                    <Button Content="入點 I" AutomationProperties.AutomationId="MarkInButton" Click="OnMarkIn" Margin="10,0,6,0" />
                    <Button Content="出點 O" AutomationProperties.AutomationId="MarkOutButton" Click="OnMarkOut" />
                    <Button x:Name="AddButton" AutomationProperties.AutomationId="AddToTimelineButton" Content="加入時間軸" Click="OnAddToTimeline" />
                    <RadioButton x:Name="SourceMode" AutomationProperties.AutomationId="SourceMode" Content="素材" GroupName="PreviewMode" IsChecked="True" Margin="10,4,8,0" Checked="OnPreviewModeChecked" />
                    <RadioButton x:Name="TimelineMode" AutomationProperties.AutomationId="TimelineMode" Content="時間軸" GroupName="PreviewMode" Margin="0,4,8,0" Checked="OnPreviewModeChecked" />
                    <TextBlock x:Name="MarkText" AutomationProperties.AutomationId="MarkText" VerticalAlignment="Center" Foreground="#FFD24A" FontFamily="Consolas" Margin="4,0,0,0" />
                </WrapPanel>
            </DockPanel>
        </StackPanel>

        <!-- 輸出設定 -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="8" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="畫面比例" Margin="0,0,0,6" />
                <WrapPanel>
                    <RadioButton x:Name="RatioOriginal" AutomationProperties.AutomationId="RatioOriginal" Content="原尺寸" GroupName="Ratio" IsChecked="True" Checked="OnOutputSettingChanged" />
                    <RadioButton x:Name="Ratio16x9" AutomationProperties.AutomationId="Ratio16x9" Content="16:9" GroupName="Ratio" Checked="OnOutputSettingChanged" />
                    <RadioButton x:Name="Ratio9x16" AutomationProperties.AutomationId="Ratio9x16" Content="9:16" GroupName="Ratio" Checked="OnOutputSettingChanged" />
                    <RadioButton x:Name="Ratio1x1" AutomationProperties.AutomationId="Ratio1x1" Content="1:1" GroupName="Ratio" Checked="OnOutputSettingChanged" />
                    <RadioButton x:Name="Ratio4x5" AutomationProperties.AutomationId="Ratio4x5" Content="4:5" GroupName="Ratio" Checked="OnOutputSettingChanged" />
                </WrapPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="處理方式" />
                <WrapPanel>
                    <RadioButton x:Name="ModeFill" AutomationProperties.AutomationId="ModeFill" Content="填滿裁切" GroupName="Mode" IsChecked="True" Checked="OnOutputSettingChanged" />
                    <RadioButton x:Name="ModePad" AutomationProperties.AutomationId="ModePad" Content="加黑邊" GroupName="Mode" Checked="OnOutputSettingChanged" />
                </WrapPanel>
                <TextBlock x:Name="OutputInfo" AutomationProperties.AutomationId="OutputInfo" Margin="0,8,0,0" FontSize="12" Foreground="#B0B0B0" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="片段清單（影片軌）" />
                <ListBox x:Name="ClipList" AutomationProperties.AutomationId="ClipList" Height="170" SelectionChanged="OnClipListSelected" DisplayMemberPath="Label" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="上移" AutomationProperties.AutomationId="MoveUpButton" Click="OnMoveUp" />
                    <Button Content="下移" AutomationProperties.AutomationId="MoveDownButton" Click="OnMoveDown" />
                    <Button Content="刪除" AutomationProperties.AutomationId="DeleteButton" Click="OnDeleteClip" ToolTip="Delete 鍵" />
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="片段音量" />
                <DockPanel>
                    <TextBlock x:Name="VolumeText" AutomationProperties.AutomationId="VolumeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="—" />
                    <Slider x:Name="VolumeSlider" AutomationProperties.AutomationId="VolumeSlider" Minimum="0" Maximum="200" IsEnabled="False" Focusable="False" ValueChanged="OnVolumeChanged" />
                </DockPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="匯出" />
                <Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" Content="匯出 MP4…" Padding="10,8" Margin="0" Click="OnExportClick" />
                <ProgressBar x:Name="ExportProgress" AutomationProperties.AutomationId="ExportProgress" Height="10" Margin="0,8,0,0" Maximum="1" />
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="取消匯出" Margin="0,6,0,0" IsEnabled="False" Click="OnCancelExport" />
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#B0B0B0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 時間軸 -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="8,0,8,8">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="時間軸" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button Content="－" AutomationProperties.AutomationId="ZoomOutButton" Click="OnZoomOut" />
                <Button Content="＋" AutomationProperties.AutomationId="ZoomInButton" Click="OnZoomIn" />
                <Button Content="顯示全部" AutomationProperties.AutomationId="ZoomFitButton" Click="OnZoomFit" />
                <TextBlock Text="Ctrl + 滾輪縮放；拖曳片段移動，拖曳邊緣調整長度" Foreground="#777777" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            </DockPanel>
            <ScrollBar x:Name="TimelineScroll" DockPanel.Dock="Bottom" Orientation="Horizontal" Scroll="OnTimelineScroll" />
            <controls:TimelineView x:Name="Timeline" AutomationProperties.AutomationId="Timeline" />
        </DockPanel>

        <!-- 尚未找到 FFmpeg 時的錯誤遮罩 -->
        <Border x:Name="FatalPanel" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#E0101010" Visibility="Collapsed">
            <TextBlock x:Name="FatalText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="600" FontSize="16" />
        </Border>
    </Grid>
</Window>
