<UserControl x:Class="VideoEditor.App.Controls.ProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- 進度面板：有工作進行時才出現，疊在預覽下方，不推動其他版面 -->
    <Border Padding="16,12" CornerRadius="6" Background="#E6202830" BorderBrush="#4A90D9" BorderThickness="1"
            AutomationProperties.AutomationId="ProgressPanel">
        <StackPanel>
            <Grid x:Name="ImportRow" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ImportText" AutomationProperties.AutomationId="ImportText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                    <ProgressBar x:Name="ImportProgress" AutomationProperties.AutomationId="ImportProgress" Height="10" Maximum="1" Foreground="#4A90D9" Background="#33FFFFFF" BorderThickness="0" />
                </StackPanel>
                <TextBlock x:Name="ImportPercent" Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="#9CC4F0" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="64" TextAlignment="Right" />
            </Grid>

            <Grid x:Name="ReverseRow" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="準備倒放預覽…" AutomationProperties.AutomationId="ReverseText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ProgressBar x:Name="ReverseProgress" AutomationProperties.AutomationId="ReverseProgress" Height="10" Maximum="1" Foreground="#B58CFF" Background="#33FFFFFF" BorderThickness="0" />
                </StackPanel>
                <TextBlock x:Name="ReversePercent" Grid.Column="1" FontSize="20" FontWeight="Bold" Foreground="#C9B0FF" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="64" TextAlignment="Right" />
            </Grid>

            <Grid x:Name="ExportRow" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ExportText" AutomationProperties.AutomationId="ExportText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                    <ProgressBar x:Name="ExportProgress" AutomationProperties.AutomationId="ExportProgress" Height="14" Maximum="1" Foreground="#4CC26A" Background="#33FFFFFF" BorderThickness="0" />
                </StackPanel>
                <TextBlock x:Name="ExportPercent" AutomationProperties.AutomationId="ExportPercent" Grid.Column="1" FontSize="26" FontWeight="Bold" Foreground="#7FE09A" VerticalAlignment="Center" Margin="16,0,12,0" MinWidth="80" TextAlignment="Right" />
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Grid.Column="2" Content="取消匯出" VerticalAlignment="Center" Margin="0" Click="OnCancelClick" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
